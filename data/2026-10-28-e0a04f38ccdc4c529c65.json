 "news": [
  {
   "player": "Anthony Black",
   "team": "ORL",
   "status": "Q",
   "note": "High usage player projected for 30 minutes. His absence would provide a boost for the rest of the team, especially with Paolo Banchero already ruled out.",
   "time": "2:00 PM"
  },
  {
   "player": "Lauri Markkanen",
   "team": "UTA",
   "status": "Q",
   "note": "If he's out, the starters would see a boost in usage. Kyle Filipowski and Brice Sensabaugh would see an uptick in playing time.",
   "time": "2:00 PM"
  },
  {
   "player": "Kyrie Irving",
   "team": "DAL",
   "status": "Q",
   "note": "26% usage rate this season. His absence would give a boost to the other starters. Zaccharie Risacher would have a path to more minutes.",
   "time": "2:00 PM"
  },
  {
   "player": "Tyrese Haliburton",
   "team": "IND",
   "status": "Q",
   "note": "Most productive fantasy player for the Pacers. His absence would open up a ton of usage and a potential spot start for Quenton Jackson.",
   "time": "2:00 PM"
  },
  {
   "player": "Ajay Mitchell",
   "team": "OKC",
   "status": "Q",
   "note": "The Thunder have already ruled out Chet Holmgren, Jalen Williams, and Cason Wallace, so Mitchell being out would make the Thunder even more appealing.",
   "time": "2:00 PM"
  },
  {
   "player": "Andrew Nembhard",
   "team": "IND",
   "status": "Q",
   "note": "Big boost for him if Haliburton is out. If he's out, Quenton Jackson would see an uptick in minutes.",
   "time": "2:00 PM"
  },
  {
   "player": "AJ Dybantsa",
   "team": "WAS",
   "status": "Q",
   "note": "Has yet to play this season, so we know what to expect from Washington if he's out again.",
   "time": "2:00 PM"
  },
  {
   "player": "Yaxel Lendeborg",
   "team": "GSW",
   "status": "Q",
   "note": "Been one of the best players for the Warriors this season. If he's out, we could see a spot start for De'Anthony Melton or Al Horford.",
   "time": "2:00 PM"
  },
  {
   "player": "Jaxson Hayes",
   "team": "UTA",
   "status": "Q",
   "note": "Starting and averaging 24 minutes per game. If he's out, Mo Bamba and Kyle Filipowski would see a boost in minutes.",
   "time": "2:00 PM"
  },
  {
   "player": "Naji Marshall",
   "team": "DAL",
   "status": "Q",
   "note": "Playing great off the bench for the Mavericks. Zaccharie Risacher and the starters would all see small boosts if he's out.",
   "time": "2:00 PM"
  },
  {
   "player": "Marcus Smart",
   "team": "HOU",
   "status": "Q",
   "note": "Averaging 24 minutes per game. Even if he's out, the Rockets haven't been an attractive team to target in DFS this season.",
   "time": "2:00 PM"
  },
  {
   "player": "Yaxel Lendeborg",
   "team": "GSW",
   "status": "Q",
   "note": "He is still questionable, but he went through shootaround.",
   "time": "3:20 PM"
  }
